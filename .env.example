# Clerk Authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Turso Database (Serverless SQLite)
# Get these from https://turso.tech dashboard or `turso db show <db-name>`
EXPO_PUBLIC_TURSO_DATABASE_URL=libsql://[your-db-name]-[your-org].turso.io
EXPO_PUBLIC_TURSO_AUTH_TOKEN=[your-database-auth-token]
